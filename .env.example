# DashScope API Key（阿里云通义千问）
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# LLM 模型（对话 / 轻量任务）
# CHAT_MODEL=qwen-max
# CHAT_MODEL_LIGHT=qwen-turbo
# EMBEDDINGS_MODEL=text-embedding-v4
# Query Rewrite 指代补全默认项目名
# REWRITE_PROJECT_NAME=Mem-RAG

# 检索严格门控：无命中 / 关键词不匹配时不调用 LLM（默认 true）
# RETRIEVAL_STRICT_GATE=true
# RETRIEVAL_MIN_KEYWORD_HITS=1
# NO_KB_ANSWER_MESSAGE=知识库中暂无相关信息，请尝试上传相关文档或换个问法。

# MySQL 连接（async 驱动）
DATABASE_URL=mysql+aiomysql://root:your_password@localhost:3306/memrag_db

# 密码哈希旧版兼容盐（仅用于迁移旧用户，新用户使用 bcrypt）
SALT_SUFFIX=MYRAG

# CORS 允许来源（逗号分隔）
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# 开发：允许 IDE 直接打开 html（如 localhost:63342）访问 API；生产建议 false
# CORS_ALLOW_LOCALHOST_ANY_PORT=true

# Cookie 安全选项（本地 HTTP 开发保持 false / lax）
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Milvus Lite 本地库路径（可选）
# MILVUS_URI=./database/milvus_db.db

# Hybrid Retrieval（Dense + Sparse → RRF → Rerank）
# DENSE_EMBEDDING_PROVIDER=dashscope
# DENSE_EMBEDDING_PROVIDER=bge-m3
# DENSE_MODEL_NAME=BAAI/bge-m3
# RERANKER_ENABLED=true
# RERANKER_MODEL_NAME=BAAI/bge-reranker-v2
# RETRIEVAL_CANDIDATE_K=10
# RETRIEVAL_TOP_K=3
# RRF_K=60
