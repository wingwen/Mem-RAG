# DashScope API Key（阿里云通义千问）
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# LLM 模型（对话 / 轻量任务，在 DashScope 控制台确认已开通）
CHAT_MODEL=qwen3-8b
CHAT_MODEL_LIGHT=qwen3-8b
# EMBEDDINGS_MODEL=text-embedding-v4

# 生产检索策略 A3（推荐，勿改为宽召回无 Rerank）
RETRIEVAL_RECALL_K=15
RERANK_ENABLED=true
RERANK_MODEL=gte-rerank-v2
RERANK_TOP_N=5
# RERANK_ENABLED=false 时自动回退 A1 hybrid_legacy，不会走易误导的 A2 路径

# MySQL 连接（async 驱动）
DATABASE_URL=mysql+aiomysql://root:your_password@localhost:3306/memrag_db

# 密码哈希旧版兼容盐（仅用于迁移旧用户，新用户使用 bcrypt）
SALT_SUFFIX=MYRAG

# CORS 允许来源（逗号分隔）
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# 开发：允许 IDE 直接打开 html（如 localhost:63342）访问 API；生产建议 false
# CORS_ALLOW_LOCALHOST_ANY_PORT=true

# Cookie 安全选项（本地 HTTP 开发保持 false / lax）
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Milvus Lite 本地库路径（可选）
# MILVUS_URI=./database/milvus_db.db
